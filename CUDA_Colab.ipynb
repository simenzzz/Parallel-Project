   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Parallel 3D Voxelization - CUDA Backend\n",
    "\n",
    "This notebook compiles and runs the CUDA parallel implementation of the 3D Voxelization project."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clone the repository\n",
    "!git clone https://github.com/simenzzz/Parallel-Project.git\n",
    "%cd Parallel-Project"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build the required targets\n",
    "# Note: Colab GPUs usually support sm_75 (T4) or higher\n",
    "!make clean\n",
    "!make CUDA_ARCH=sm_75 sequential cuda verify"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run the sequential baseline\n",
    "!bin/voxelize_seq -i data/airplane_0001.off -r 128 -o results/seq.voxel -c results/colab.csv\n",
    "\n",
    "# Run the CUDA backend with optimized block sizes\n",
    "!bin/voxelize_cuda -i data/airplane_0001.off -r 128 -b 256 -o results/cuda.voxel -c results/colab.csv\n",
    "\n",
    "# Verify correctness\n",
    "!bin/verify results/seq.voxel results/cuda.voxel"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Display the results\n",
    "!cat results/colab.csv"
   ]
  }
 ],
